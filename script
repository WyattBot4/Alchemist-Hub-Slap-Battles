local SelectedPotion = nil

local function hasAlchemistTool()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")

    if not char or not backpack then return false end

    return char:FindFirstChild("Alchemist") or backpack:FindFirstChild("Alchemist")
end

local function isPlayerInArena()
    local arenaBool = Character:FindFirstChild("isInArena")
    return arenaBool and arenaBool.Value
end

MainTab:CreateDropdown({
    Name = "Select Ingredients to Collect",
    Options = Ingredients,
    CurrentOption = {},
    MultipleOptions = true,
    Callback = function(options)
        SelectedIngredients = options
    end,
})

local CollectToggleRef

CollectToggleRef = MainTab:CreateToggle({
    Name = "Collect All Ingredients",
    CurrentValue = false,
    Flag = "CollectToggle",
    Callback = function(Value)
        Collecting = Value
        if Collecting then
            task.spawn(function()
                while Collecting do
                    local hrp = Character:FindFirstChild("HumanoidRootPart")
                    local folder = Workspace:FindFirstChild("Alchemist_Ingredients_")

                    if not isPlayerInArena() then
                        notify("Error", "You must be in the arena!", 4)
                        Collecting = false
                        CollectToggleRef:Set(false)
                        break
                    end
                    if not hasAlchemistTool() then
                        notify("Error", "You need the Alchemist glove equipped!", 4)
                        Collecting = false
                        CollectToggleRef:Set(false)
                        break
                    end

                    if not folder or not hrp then
                        task.wait(0.1)
                        continue
                    end

                    local SelectedMap = {}
                    for _, v in ipairs(SelectedIngredients) do
                        SelectedMap[v] = true
                    end

                    for _, ingredient in ipairs(folder:GetChildren()) do
                        if not Collecting then break end
                        if SelectedMap["All"] or SelectedMap[ingredient.Name] then
                            local clickbox = ingredient:FindFirstChild("Clickbox")
                            if clickbox and hrp then
                                task.spawn(function()
                                    firetouchinterest(hrp, clickbox, 0)
                                    firetouchinterest(hrp, clickbox, 1)
                                    local cd = clickbox:FindFirstChildOfClass("ClickDetector")
                                    if cd then
                                        cd.MaxActivationDistance = math.huge
                                        fireclickdetector(cd)
                                    end
                                end)
                            end
                        end
                    end

                    task.wait(0.05)
                end
            end)
        end
    end,
})

MainTab:CreateDropdown({
    Name = "Select Potion",
    Options = (function()
        local t = {"All"}
        for name, _ in pairs(Potions) do
            table.insert(t, name)
        end
        return t
    end)(),
    CurrentOption = {},
    MultipleOptions = false,
    Callback = function(option)
        SelectedPotion = option[1]
    end,
})

MainTab:CreateButton({
    Name = "Craft Selected Potion",
    Callback = function()
        if not SelectedPotion then
            notify("Error", "No potion selected!", 4)
            return
        end
        if not isPlayerInArena() then
            notify("Error", "You must be in the arena to craft!", 4)
            return
        end
        if not hasAlchemistTool() then
            notify("Error", "Equip the Alchemist glove first!", 4)
            return
        end

        local rs = game:GetService("ReplicatedStorage")
        local alch = rs:WaitForChild("AlchemistEvent")
        local ability = rs:WaitForChild("GeneralAbility")

        task.spawn(function()
            local cauldronName = LocalPlayer.Name .. "'s Cauldron"
            if not workspace:FindFirstChild(cauldronName) then
                ability:FireServer()
                task.wait(0.01)
            end

            local function craftPotion(recipe)
                for _, ingredientName in ipairs(recipe) do
                    alch:FireServer("UnEquipItems")
                    alch:FireServer("EquipItem", ingredientName)
                    task.wait(0.01)
                    alch:FireServer("MixItem", ingredientName)
                    task.wait(0.01)
                end
                alch:FireServer("BrewPotion")
                task.wait(0.2)
            end

            if SelectedPotion == "All" then
                for _, recipe in pairs(Potions) do
                    craftPotion(recipe)
                end
            else
                craftPotion(Potions[SelectedPotion])
            end

            notify("Success", "Potion crafted successfully!", 3)
        end)
    end,
})
