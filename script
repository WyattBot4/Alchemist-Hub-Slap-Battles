local RangeSlapEnabled = false
local RangeValue = 20
local RangePart = nil

local function createRangeBox()
    if RangePart then RangePart:Destroy() end
    RangePart = Instance.new("Part")
    RangePart.Anchored = true
    RangePart.CanCollide = false
    RangePart.Transparency = 0.7
    RangePart.Color = Color3.fromRGB(0,170,255)
    RangePart.Material = Enum.Material.ForceField
    RangePart.Name = "SlapRangeBox"
    RangePart.Parent = workspace
end

local function updateRangeBox()
    if not RangeSlapEnabled then return end
    local hrp = Character and Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not RangePart then createRangeBox() end
    RangePart.Size = Vector3.new(RangeValue, RangeValue, RangeValue)
    RangePart.CFrame = hrp.CFrame
end

local function removeRangeBox()
    if RangePart then
        RangePart:Destroy()
        RangePart = nil
    end
end

