local UserInputService = game:GetService("UserInputService")
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 and RangeSlapEnabled then
        local hrp = Character and Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local size = Vector3.new(RangeValue, RangeValue, RangeValue)
        local cf = hrp.CFrame

        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Blacklist
        params.FilterDescendantsInstances = {Character}

        local parts = workspace:GetPartBoundsInBox(cf, size, params)

        local hitPlayers = {}

        for _, part in pairs(parts) do
            local model = part:FindFirstAncestorOfClass("Model")
            if model and model ~= Character then
                local player = Players:GetPlayerFromCharacter(model)
                if player and not hitPlayers[player] then
                    hitPlayers[player] = true

                    local targetRoot = model:FindFirstChild("HumanoidRootPart")
                    if targetRoot then
                        playSlapAnimation()
                        bRemote:FireServer(targetRoot)
                    end
                end
            end
        end
    end
end)

