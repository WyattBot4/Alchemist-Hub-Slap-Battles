local CollectToggleRef
CollectToggleRef = MainTab:CreateToggle({
    Name = "Collect All Ingredients",
    CurrentValue = false,
    Callback = function(Value)
        Collecting = Value
        if Collecting then
            task.spawn(function()
                while Collecting do
                    local hrp = Character:FindFirstChild("HumanoidRootPart")
                    local folder = Workspace:FindFirstChild("Alchemist_Ingredients_")
                    if not isPlayerInArena() then
                        notify("Error", "You must be in the arena!", 4)
                        Collecting = false
                        CollectToggleRef:Set(false)
                        break
                    end
                    if not hasAlchemistTool() then
                        notify("Error", "You need the Alchemist glove!", 4)
                        Collecting = false
                        CollectToggleRef:Set(false)
                        break
                    end
                    if not folder or not hrp then task.wait(0.1) continue end
                    local SelectedMap = {}
                    for _, v in ipairs(SelectedIngredients) do SelectedMap[v] = true end
                    for _, ingredient in ipairs(folder:GetChildren()) do
                        if not Collecting then break end
                        if SelectedMap["All"] or SelectedMap[ingredient.Name] then
                            local clickbox = ingredient:FindFirstChild("Clickbox")
                            if clickbox then
                                task.spawn(function()
                                    firetouchinterest(hrp, clickbox, 0)
                                    firetouchinterest(hrp, clickbox, 1)
                                    local cd = clickbox:FindFirstChildOfClass("ClickDetector")
                                    if cd then
                                        cd.MaxActivationDistance = math.huge
                                        fireclickdetector(cd)
                                    end
                                end)
                            end
                        end
                    end
                    task.wait(0.05)
                end
            end)
        end
    end,
})
