local RepStorage = game:GetService("ReplicatedStorage")
local bRemote = RepStorage:WaitForChild("b")
local function getHumanoidRootPart(player) return player.Character and player.Character:FindFirstChild("HumanoidRootPart") end
local function getAnimator()
    local humanoid = Character and Character:FindFirstChild("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    return animator
end
local function playSlapAnimation()
    local animator = getAnimator()
    if not animator then return end
    local slapAnim = RepStorage:FindFirstChild("Slap")
    if slapAnim then
        local track = animator:LoadAnimation(slapAnim)
        track:Play()
    end
end
MainTab:CreateToggle({
    Name = "Safe Slap Aura",
    CurrentValue = false,
    Callback = function(val)
        SafeSlapEnabled = val
        if SafeSlapEnabled then
            task.spawn(function()
                while SafeSlapEnabled do
                    local hrp = Character:FindFirstChild("HumanoidRootPart")
                    if not hrp then task.wait(0.2) continue end
                    local closestPlayer = nil
                    local closestDistance = SafeSlapRange + 1
                    for _, player in pairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and player.Character then
                            local targetRoot = getHumanoidRootPart(player)
                            local ragdoll = player.Character:FindFirstChild("Ragdolled")
                            local arena = player.Character:FindFirstChild("isInArena")
                            if targetRoot and arena and arena.Value and ragdoll and ragdoll.Value == false then
                                local distance = (hrp.Position - targetRoot.Position).Magnitude
                                if distance < closestDistance then
                                    closestDistance = distance
                                    closestPlayer = player
                                end
                            end
                        end
                    end
                    if closestPlayer then
                        local targetRoot = getHumanoidRootPart(closestPlayer)
                        playSlapAnimation()
                        if targetRoot then bRemote:FireServer(targetRoot) end
                    end
                    task.wait(1)
                end
            end)
        end
    end
})
